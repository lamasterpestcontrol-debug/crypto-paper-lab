# history-replay + strategy-shadow-ab + v0.5/v0.6
FROM python:3.12-slim-bookworm
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY discovery.py test_discovery.py history_replay.py test_history_replay.py launcher.py      strategy_v03.py test_strategy_v03.py strategy_v04.py test_strategy_v04.py      strategy_v05.py test_strategy_v05.py strategy_v06.py test_strategy_v06.py      shadow_ab.py test_shadow_ab.py ./
RUN python -m unittest -v test_discovery test_history_replay test_strategy_v03 test_strategy_v04 test_strategy_v05 test_strategy_v06 test_shadow_ab
CMD ["python", "-u", "launcher.py"]
